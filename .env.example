# ---------------------------------------------------------------------------
# Server (put into server/.env locally, or as environment variables on Render)
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Supabase: Project Settings -> API Keys. Without these, everybody plays as guest.
# The secret key must NEVER be committed or put into the client!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Client (optional overrides, defaults are in client/src/config.js)
# ---------------------------------------------------------------------------
# REACT_APP_SERVER_URL=http://localhost:3001
# REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
# REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
